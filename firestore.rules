rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == "m.mucahitbayar@gmail.com" ||
        request.auth.token.email == "admin@gmail.com"
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidApplication(data) {
      let requiredFields = ['name', 'surname', 'email', 'phone', 'influencerName', 'platformLinks', 'followerCount', 'platforms', 'contractAccepted', 'status', 'createdAt'];
      return data.keys().hasAll(requiredFields) && 
             data.name is string && data.name.size() >= 2 && data.name.size() < 100 &&
             data.surname is string && data.surname.size() >= 2 && data.surname.size() < 100 &&
             data.email is string && data.email.matches('^.+@.+$') && data.email.size() < 150 &&
             data.phone is string && data.phone.size() >= 10 && data.phone.size() < 30 &&
             data.influencerName is string && data.influencerName.size() >= 2 && data.influencerName.size() < 100 &&
             data.platformLinks is map && data.platformLinks.keys().size() > 0 &&
             data.followerCount is string && data.followerCount.size() < 100 &&
             data.platforms is list && data.platforms.size() > 0 && data.platforms.size() < 10 &&
             data.contractAccepted == true &&
             data.status == 'waiting' &&
             data.createdAt == request.time &&
             (!('message' in data) || (data.message is string && data.message.size() < 1000));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['email', 'role', 'createdAt']) &&
             data.keys().size() == 3 &&
             data.email is string &&
             data.role in ['admin', 'user'] &&
             data.createdAt == request.time;
    }

    // Collection Rules
    match /applications/{applicationId} {
      allow create: if isValidApplication(incoming());
      
      allow get, update, delete: if isValidId(applicationId) && isAdmin();
      allow list: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming()) && incoming().role == 'user';
      
      allow update: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Managed manually or via server
    }
  }
}
